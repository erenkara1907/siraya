# ─────────────────────────────────────────────────────────────────────────────
#  Sıraya — .env.example. Copy to .env.local and fill in.
#
#  With no keys set, Sıraya runs in DEMO MODE from lib/demo/data.ts:
#  sample channels, a full calendar, a queue and analytics. Nothing persists.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase — real login + stores channels, posts, metrics and activity ─────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the publish cron to act
# across users when a scheduled post comes due.
SUPABASE_SERVICE_ROLE_KEY=

# ── Instagram — publishes via Instagram API with Business Login ──────────────
# developers.facebook.com → your app → Instagram → Business login settings.
# Standard Access needs no App Review, but only reaches Instagram accounts that
# hold a role (admin/developer/tester) on your Meta app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional. Pins the Graph version; leave blank to use the built-in default.
INSTAGRAM_API_VERSION=
# Optional. Only needed when the App Dashboard stored the redirect URI in a form
# we would not generate — a trailing slash, most often. Paste the list entry
# character for character; blank derives it from NEXT_PUBLIC_APP_URL.
INSTAGRAM_REDIRECT_URI=

# Protects the publish cron endpoint. Any long random string.
CRON_SECRET=

# ── Resend — approval requests and publish digests (optional) ────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
